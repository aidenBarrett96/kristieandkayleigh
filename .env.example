# Postgres connection string (Vercel Postgres / Neon).
# In Vercel, this is provided automatically when you add a Postgres store.
# For Neon, copy the "pooled" connection string from the dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password for the /admin dashboard.
ADMIN_PASSWORD="change-me-please"

# Public base URL of the deployed site, used to build QR-code links.
# e.g. https://kristieandkayleigh.vercel.app  (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Vercel Blob store token (private store) for guest photo uploads.
# Auto-injected on Vercel when you link a Blob store; for local dev run
# `vercel env pull` or copy it from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
